(version 0.7.2)

(build
 (all_platforms ((action (run dune build -p %{pkg-self:name} -j %{jobs})))))

(depends
 (all_platforms
  (ocaml
   dune
   ke
   bstr
   unstrctrd
   ptime
   uutf
   rosetta
   ipaddr
   emile
   base64
   pecu
   prettym
   angstrom)))


(version 3.17.3)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run dune build -p %{pkg-self:name} -j %{jobs} @install))))))

(depends
 (all_platforms
  (dune
   ocaml
   ocamlfind
   cmdliner
   dune-build-info
   menhir
   merlin-extend
   fix
   cppo
   ppxlib)))

(source
 (fetch
  (url
   https://github.com/reasonml/reason/releases/download/3.17.3/reason-3.17.3.tbz)
  (checksum
   sha512=f167097b3254fbf400bb816275f84157a0a9c691ebc877861e80b1c32c7e2ebc553e0a6a0ef073ec89c2c20ce80c42959dc89811e49712edd0c1fe6dce4a90e9)))
